---
import type { GetStaticPaths } from "astro";
import Card from "../../components/ui/Card.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, subjects } from "../../config/site";
import { locales, useTranslations, type UiKey } from "../../i18n";
import { subjectPath, topicPath } from "../../lib/paths";
import { websiteGraph } from "../../lib/seo";

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang }, props: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.props;
const t = useTranslations(lang);
const title = `${t("site.title")} · ${site.author}`;
const description = t("site.description", { author: site.author });
const structured = websiteGraph(site);
---

<BaseLayout lang={lang} eyebrow={t("site.title")} heading={t("nav.subjects")} title={title} description={description} structured={structured}>
  <div class="grid">
    {
      subjects.map((subject) => (
        <Card as="section">
          <h2>
            <span class="mr">{subject.symbol}</span> {t(`subjects.${subject.slug}` as UiKey)}
          </h2>
          {subject.status === "soon" ? (
            <a class="soon eyebrow" href={subjectPath(lang, subject.slug)}>
              {t("nav.soonTitle")}
            </a>
          ) : (
            <ul>
              {subject.topics.map((topic) => (
                <li>
                  <a href={topicPath(lang, subject.slug, topic.slug)}>
                    {t(`topics.${topic.slug}` as UiKey)}
                    {topic.symbol && <span class="mr"> {topic.symbol}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </Card>
      ))
    }
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }

  h2 {
    font-size: 22px;
    margin-bottom: 12px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  a {
    text-decoration: none;
  }

  li a {
    font-weight: 600;
    border-bottom: 1px solid var(--line);
  }

  li a:hover {
    border-bottom-color: currentColor;
  }

  .soon:hover {
    color: var(--fg);
  }
</style>
