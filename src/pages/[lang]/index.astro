---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { subjects } from "../../config/site";
import { locales, useTranslations, type Locale } from "../../i18n";

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t("site.title")}>
  <div class="wrap">
    <h1>{t("site.title")}</h1>
    <ul>
      {
        subjects.map((s) => (
          <li>
            <span class="mr">{s.symbol}</span> {t(`subjects.${s.slug}`)}
            {s.status === "soon" && <span class="eyebrow"> {t("nav.soonTitle")}</span>}
            <ul>
              {s.topics.map((topic) => (
                <li>
                  <a href={`/${lang}/${s.slug}/${topic.slug}/`}>{t(`topics.${topic.slug}`)}</a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
