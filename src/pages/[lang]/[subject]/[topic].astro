---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { subjects } from "../../../config/site";
import { contentLocale, locales, useTranslations, type UiKey } from "../../../i18n";

export const getStaticPaths = (() =>
  locales.flatMap((lang) =>
    subjects.flatMap((subject) =>
      subject.topics.map((topic) => ({
        params: { lang, subject: subject.slug, topic: topic.slug },
        props: { lang, subject, topic },
      })),
    ),
  )) satisfies GetStaticPaths;

const { lang, subject, topic } = Astro.props;
const t = useTranslations(lang);
const content = contentLocale(lang, topic.locales);
---

<BaseLayout
  lang={lang}
  eyebrow={t(`subjects.${subject.slug}` as UiKey)}
  heading={t(`topics.${topic.slug}` as UiKey)}
  subject={subject}
  topic={topic.slug}
>
  {content.fallback && <p class="note">{t("nav.contentFallback")}</p>}
</BaseLayout>

<style>
  .note {
    border: 1px solid var(--line);
    border-left: 3px solid var(--tan);
    background: var(--surface);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
