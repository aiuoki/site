---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import "../../../styles/components/katex.css";
import "../../../styles/components/guide.css";
import "../../../styles/components/demo-dialog.css";
import { guideComponents } from "../../../components/guide";
import TopicApp from "../../../components/interactive/TopicApp.astro";
import DemoDialogs from "../../../components/ui/DemoDialogs.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { site, subjects } from "../../../config/site";
import { demosForTopic } from "../../../demos";
import { contentLocale, localeMeta, locales, useTranslations, type UiKey } from "../../../i18n";
import { switchLocale } from "../../../lib/paths";
import { topicGraph } from "../../../lib/seo";

export const getStaticPaths = (() =>
  locales.flatMap((lang) =>
    subjects.flatMap((subject) =>
      subject.topics.map((topic) => ({
        params: { lang, subject: subject.slug, topic: topic.slug },
        props: { lang, subject, topic },
      })),
    ),
  )) satisfies GetStaticPaths;

const { lang, subject, topic } = Astro.props;
const t = useTranslations(lang);
const content = contentLocale(lang, topic.locales);
// Formulas, figures and guide labels follow the language of the notes.
Astro.locals.contentLang = content.locale;
const tc = useTranslations(content.locale);
const entryId = `${subject.slug}/${topic.slug}/${content.locale}`;
// Topics without written notes yet render only their header and canvas.
const entry = (await getCollection("notes")).find((e) => e.id === entryId);
const rendered = entry ? await render(entry) : null;
const demos = demosForTopic(topic.slug, content.locale);
const heading = entry?.data.title ?? t(`topics.${topic.slug}` as UiKey);
// A page showing another language's notes points search engines to the original.
const canonical = new URL(content.fallback ? switchLocale(Astro.url.pathname, content.locale) : Astro.url.pathname, site.url).href;
const structured = entry
  ? topicGraph(site, { title: heading, description: entry.data.description, url: canonical, bcp47: localeMeta[content.locale].bcp47 })
  : undefined;
---

<BaseLayout
  lang={lang}
  eyebrow={entry?.data.eyebrow ?? t(`subjects.${subject.slug}` as UiKey)}
  heading={heading}
  intro={entry?.data.intro}
  description={entry?.data.description}
  canonical={canonical}
  structured={structured}
  alternates={topic.locales}
  contentLang={content.locale}
  subject={subject}
  topic={topic.slug}
>
  {content.fallback && <p class="note">{t("nav.contentFallback")}</p>}
  <div lang={content.fallback ? content.locale : undefined}>
    <TopicApp lang={lang} content={content.locale} topic={topic.slug} />
    {
      rendered && (
        <div class="guide">
          <rendered.Content components={guideComponents} />
        </div>
      )
    }
    <DemoDialogs demos={demos} labels={{ title: tc("demo.title"), use: tc("demo.use"), close: tc("demo.close") }} />
  </div>
</BaseLayout>

<style>
  .note {
    border: 1px solid var(--line);
    border-left: 3px solid var(--tan);
    background: var(--surface);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 24px;
  }
</style>
