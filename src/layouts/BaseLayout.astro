---
import "@fontsource/young-serif/400.css";
import "@fontsource-variable/figtree/wght.css";
import "@fontsource-variable/figtree/wght-italic.css";
import "@fontsource/stix-two-text/400.css";
import "@fontsource/stix-two-text/400-italic.css";
import "@fontsource/stix-two-text/600.css";
import "@fontsource/stix-two-text/600-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import SeoHead from "../components/layout/SeoHead.astro";
import SubjectNav from "../components/layout/SubjectNav.astro";
import Support from "../components/layout/Support.astro";
import TopicTabs from "../components/layout/TopicTabs.astro";
import { aliases, themeStorageKey, themes } from "../config/theme";
import { site, type Subject } from "../config/site";
import { useTranslations, type Locale } from "../i18n";
import { themeCss } from "../lib/theme-css";

interface Props {
  lang: Locale;
  eyebrow: string;
  heading: string;
  intro?: string;
  description?: string;
  // Full document title; defaults to "<heading> · <author>".
  title?: string;
  // URL to index instead of this one (pages showing another language's notes).
  canonical?: string;
  // schema.org data for this page.
  structured?: unknown;
  // Languages the page content exists in; all by default.
  alternates?: readonly Locale[];
  // Language of the notes when the page shows a fallback translation.
  contentLang?: Locale;
  noindex?: boolean;
  subject?: Subject;
  topic?: string;
}

const { lang, eyebrow, heading, intro, subject, topic, structured, alternates, contentLang, noindex } = Astro.props;
const t = useTranslations(lang);
const title = Astro.props.title ?? `${heading} · ${site.author}`;
const description = Astro.props.description ?? t("site.description", { author: site.author });
const css = themeCss(themes, aliases);
const path = Astro.url.pathname;
const canonical = Astro.props.canonical ?? new URL(path, site.url).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead
      lang={contentLang ?? lang}
      title={title}
      description={description}
      canonical={canonical}
      path={path}
      alternates={alternates}
      noindex={noindex}
      structured={structured}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:inline set:html={css} />
    <script is:inline define:vars={{ themeStorageKey }}>
      // Runs before paint so the stored theme never flashes.
      try {
        const saved = localStorage.getItem(themeStorageKey);
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="page wrap">
      <Header lang={lang} eyebrow={eyebrow} title={heading} intro={intro} />
      <div class="navs">
        <SubjectNav lang={lang} current={subject?.slug} />
        {subject && subject.topics.length > 0 && <TopicTabs lang={lang} subject={subject} current={topic} />}
      </div>
      <main>
        <slot />
      </main>
      <Support lang={lang} />
      <Footer />
    </div>
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-height: calc(100dvh - 50px);
  }

  .navs {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Pushes the support block and the footer to the bottom on short pages. */
  main {
    flex: 1 0 auto;
    min-width: 0;
  }
</style>
