---
import "@fontsource/young-serif/400.css";
import "@fontsource-variable/figtree/wght.css";
import "@fontsource-variable/figtree/wght-italic.css";
import "@fontsource/stix-two-text/400.css";
import "@fontsource/stix-two-text/400-italic.css";
import "@fontsource/stix-two-text/600.css";
import "@fontsource/stix-two-text/600-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import SubjectNav from "../components/layout/SubjectNav.astro";
import Support from "../components/layout/Support.astro";
import TopicTabs from "../components/layout/TopicTabs.astro";
import { aliases, themeStorageKey, themes } from "../config/theme";
import { site, type Subject } from "../config/site";
import { localeMeta, locales, useTranslations, type Locale } from "../i18n";
import { themeCss } from "../lib/theme-css";
import { switchLocale } from "../lib/paths";

interface Props {
  lang: Locale;
  eyebrow: string;
  heading: string;
  intro?: string;
  description?: string;
  subject?: Subject;
  topic?: string;
}

const { lang, eyebrow, heading, intro, description, subject, topic } = Astro.props;
const t = useTranslations(lang);
const title = `${heading} · ${t("site.title")}`;
const css = themeCss(themes, aliases);
const path = Astro.url.pathname;
const canonical = new URL(path, site.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {locales.map((code) => <link rel="alternate" hreflang={code} href={new URL(switchLocale(path, code), site.url)} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:locale" content={localeMeta[lang].bcp47.replace("-", "_")} />
    <style is:inline set:html={css} />
    <script is:inline define:vars={{ themeStorageKey }}>
      // Runs before paint so the stored theme never flashes.
      try {
        const saved = localStorage.getItem(themeStorageKey);
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="page wrap">
      <Header lang={lang} eyebrow={eyebrow} title={heading} intro={intro} />
      <div class="navs">
        <SubjectNav lang={lang} current={subject?.slug} />
        {subject && subject.topics.length > 0 && <TopicTabs lang={lang} subject={subject} current={topic} />}
      </div>
      <main>
        <slot />
      </main>
      <Support lang={lang} />
      <Footer />
    </div>
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-height: calc(100dvh - 50px);
  }

  .navs {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Pushes the support block and the footer to the bottom on short pages. */
  main {
    flex: 1 0 auto;
    min-width: 0;
  }
</style>
