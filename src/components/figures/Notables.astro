---
import Label from "./parts/Label.astro";
import Line from "./parts/Line.astro";
import RightAngle from "./parts/RightAngle.astro";

const wide = true;
const shade = "color-mix(in srgb, var(--fg) 5%, transparent)";

type Anchor = "start" | "middle" | "end";
type Text = [x: number, y: number, text: string, color?: string, anchor?: Anchor];

const fortyFive: Text[] = [
  [105, 120, "1", "var(--fg)", "end"],
  [115, 230, "√2/2", "var(--cos)"],
  [200, 135, "√2/2", "var(--sin)", "start"],
  [78, 198, "45°", "var(--muted)"],
  [178, 85, "45°", "var(--muted)", "end"],
];
const sixty: Text[] = [
  [362, 120, "1", "var(--fg)", "end"],
  [375, 230, "1/2", "var(--cos)"],
  [412, 140, "√3/2", "var(--sin)", "end"],
  [358, 198, "60°", "var(--muted)"],
  [412, 90, "30°", "var(--muted)", "end"],
];
---

<svg class:list={["mfig", { wide }]} viewBox="0 0 560 240" aria-hidden="true">
  <path d="M40 205 L190 205 L190 55 Z" fill={shade} stroke="var(--fg)" stroke-width="2" stroke-linejoin="round" />
  <Line x1={40} y1={205} x2={190} y2={205} color="var(--cos)" width={4} />
  <Line x1={190} y1={205} x2={190} y2={55} color="var(--sin)" width={4} />
  <RightAngle x={190} y={205} dx={-1} dy={1} size={12} />
  <path d="M330 205 L420 205 L420 49 Z" fill={shade} stroke="var(--fg)" stroke-width="2" stroke-linejoin="round" />
  <path d="M420 205 L510 205 L420 49" fill="none" stroke="var(--muted)" stroke-width="1.3" stroke-dasharray="4 5" />
  <Line x1={330} y1={205} x2={420} y2={205} color="var(--cos)" width={4} />
  <Line x1={420} y1={205} x2={420} y2={49} color="var(--sin)" width={4} />
  <RightAngle x={420} y={205} dx={-1} dy={1} size={12} />
  {
    [...fortyFive, ...sixty].map(([x, y, text, color, anchor]) => (
      <Label x={x} y={y} color={color} anchor={anchor} size={17} italic={false} halo={false}>
        {text}
      </Label>
    ))
  }
</svg>
