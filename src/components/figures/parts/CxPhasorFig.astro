---
import { contentLang, notationFor } from "../../../i18n";
import { plane } from "../../../lib/complex-figure";
import { polar } from "../../../lib/figure";
import CxArc from "./CxArc.astro";
import CxArrow from "./CxArrow.astro";
import CxAxes from "./CxAxes.astro";
import CxCirc from "./CxCirc.astro";
import CxDot from "./CxDot.astro";
import CxLine from "./CxLine.astro";
import CxText from "./CxText.astro";

interface Props {
  // Labels the point as e^(iθ) instead of z.
  euler?: boolean;
}

const { euler = false } = Astro.props;
const n = notationFor(contentLang(Astro));
const m = plane({ s: 85, ox: 130, oy: 125, h: 236 });
const d = 40;
const [c, s] = polar(d);
const [tx, ty] = polar(d / 2, 0.36);
---

<svg class="mfig" viewBox={m.viewBox} aria-hidden="true">
  <CxAxes m={m} x0={-1.25} x1={1.5} y0={-1.2} y1={1.3} />
  <CxCirc m={m} r={1} />
  <CxArc m={m} r={0.24} a0={0} a1={d} color="var(--fg)" width={1.6} />
  <CxText m={m} x={tx} y={ty} t="θ" italic />
  <CxLine m={m} x1={0} y1={0} x2={c} y2={0} color="var(--re)" width={4.5} />
  <CxLine m={m} x1={c} y1={0} x2={c} y2={s} color="var(--im)" width={4.5} />
  <CxArrow m={m} x1={0} y1={0} x2={c} y2={s} color="var(--z)" width={2.8} />
  <CxDot m={m} x={c} y={s} color="var(--z)" />
  <CxText m={m} x={c / 2} y={-0.14} t={`${n.cos} θ`} color="var(--re)" size={14} italic />
  <CxText m={m} x={c + 0.06} y={s / 2} t={`${n.sin} θ`} color="var(--im)" anchor="start" size={14} italic />
  <CxText m={m} x={c / 2 - 0.1} y={s / 2 + 0.12} t="1" anchor="end" size={14} />
  <CxText m={m} x={c + 0.06} y={s + 0.12} t={euler ? "e^(iθ) = 1_θ" : "z = 1_θ"} color="var(--z)" anchor="start" size={14} italic />
  <CxText m={m} x={-0.78} y={1.13} t="a² + b² = 1" color="var(--muted)" size={13} italic />
</svg>
