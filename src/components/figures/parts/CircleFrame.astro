---
// Axes and circle for the figures drawn in pixel coordinates around a centre.
interface Props {
  cx: number;
  cy: number;
  radius: number;
  viewBox?: string;
}

const { cx, cy, radius, viewBox = "0 0 300 240" } = Astro.props;
---

<svg class="mfig" viewBox={viewBox} aria-hidden="true">
  <line x1={cx - radius - 25} y1={cy} x2={cx + radius + 25} y2={cy} stroke="var(--axis)" stroke-width="1.2" />
  <line x1={cx} y1={cy + radius + 20} x2={cx} y2={cy - radius - 20} stroke="var(--axis)" stroke-width="1.2" />
  <circle cx={cx} cy={cy} r={radius} fill="none" stroke="var(--muted)" stroke-width="1.3" opacity=".7" />
  <slot />
</svg>
