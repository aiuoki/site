---
import { plane, points } from "../../../lib/complex-figure";
import { polar, tint } from "../../../lib/figure";
import CxArc from "./CxArc.astro";
import CxAxes from "./CxAxes.astro";
import CxCirc from "./CxCirc.astro";
import CxDot from "./CxDot.astro";
import CxLine from "./CxLine.astro";
import CxText from "./CxText.astro";

interface Props {
  // Fifth roots of a generic z, cube roots of 1, or cube roots of 8.
  kind: "fifth" | "cube1" | "cube8";
}

const { kind } = Astro.props;
const fifth = kind === "fifth";
const n = fifth ? 5 : 3;
const r = kind === "cube8" ? 2 : kind === "cube1" ? 1 : 1.25;
const th0 = fifth ? 50 : 0;
const m = plane({ s: kind === "cube8" ? 46 : kind === "cube1" ? 82 : 70, ox: 150, oy: 120 });
const labels = {
  fifth: ["w₀", "w₁", "w₂", "w₃", "w₄"],
  cube1: ["1", "ω = −1/2 + (√3/2)i", "ω̄ = ω²"],
  cube8: ["2", "−1 + √3 i", "−1 − √3 i"],
}[kind];
const angle = (i: number) => (th0 + 360 * i) / n;
const roots = Array.from({ length: n }, (_, i) => ({
  p: polar(angle(i), r),
  tip: polar(angle(i), r + 0.2),
  label: labels[i] ?? "",
}));
const start = th0 / n;
const [tx, ty] = polar(start + 36, 0.85);
const [sx, sy] = polar(start / 2 + 3, 0.55);
const [dx, dy] = polar(60, 0.62);
const anchorFor = (x: number) => (x > 0.2 ? "start" : x < -0.2 ? "end" : "middle");
---

<svg class="mfig" viewBox={m.viewBox} aria-hidden="true">
  <CxAxes m={m} x0={-r - 0.55} x1={r + 0.7} y0={-r - 0.4} y1={r + 0.45} />
  <CxCirc m={m} r={r} color="var(--result)" width={1.2} dash="4 4" />
  <polygon points={points(m, roots.map((root) => root.p))} fill={tint("result", 16)} stroke="var(--result)" stroke-width="1.6" />
  {
    roots.map(({ p }, i) => (
      <>
        <CxLine m={m} x1={0} y1={0} x2={p[0]} y2={p[1]} color="var(--result)" width={i ? 1.2 : 2.4} dash={i ? "3 3" : undefined} />
        <CxDot m={m} x={p[0]} y={p[1]} color="var(--result)" r={i ? 4.5 : 6} />
      </>
    ))
  }
  {
    roots.map(({ tip, label }) => (
      <CxText m={m} x={tip[0]} y={tip[1]} t={label} color="var(--result)" anchor={anchorFor(tip[0])} size={13} italic />
    ))
  }
  {
    fifth ? (
      <>
        <CxArc m={m} r={0.42} a0={0} a1={start} color="var(--z)" />
        <CxArc m={m} r={0.62} a0={start} a1={start + 72} color="var(--muted)" width={1.3} />
        <CxText m={m} x={tx} y={ty} t="2π/5" color="var(--muted)" size={12} italic />
        <CxText m={m} x={sx} y={sy} t="θ/5" color="var(--z)" anchor="start" size={11} italic />
      </>
    ) : (
      <>
        <CxText m={m} x={dx} y={dy} t="120°" color="var(--muted)" size={12} />
        <CxArc m={m} r={0.36} a0={0} a1={120} color="var(--muted)" width={1.2} />
      </>
    )
  }
</svg>
