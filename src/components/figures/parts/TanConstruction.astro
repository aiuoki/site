---
// Tangent line at x = 1 with the right triangle it forms with the radius.
import { unitAngle } from "../../../lib/figure";
import Dot from "./Dot.astro";
import Line from "./Line.astro";
import RightAngle from "./RightAngle.astro";

interface Props {
  hypotenuse: string;
  tangent: string;
}

const { hypotenuse, tangent } = Astro.props;
const { tn } = unitAngle(40);
---

<Line unit x1={1} y1={-0.25} x2={1} y2={1.3} color="var(--muted)" width={1} dash="3 5" />
<Line unit x1={0} y1={0} x2={1} y2={0} color="var(--muted)" width={2} />
<Line unit x1={0} y1={0} x2={1} y2={tn} color={hypotenuse} width={hypotenuse === "var(--fg)" ? 2 : 4} />
<Line unit x1={1} y1={0} x2={1} y2={tn} color={tangent} width={4} />
<RightAngle unit x={1} y={0} dx={-1} dy={1} />
<Dot unit x={1} y={tn} color={tangent} />
