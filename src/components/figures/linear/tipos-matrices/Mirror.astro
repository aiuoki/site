---
import MatrixRow from "./MatrixRow.astro";
import { cellsOf } from "./grid";

const sub = ["₁", "₂", "₃"];
const entry = (i: number, j: number) => `a${sub[i]}${sub[j]}`;
const A = [0, 1, 2].map((i) => [0, 1, 2].map((j) => entry(i, j)));
const At = [0, 1, 2].map((i) => [0, 1, 2].map((j) => entry(j, i)));
const pair = (i: number, j: number) => {
  if (i === j) return "g";
  const key = Math.min(i, j) * 3 + Math.max(i, j);
  return key === 1 ? "a" : key === 2 ? "b" : "cot";
};
const fills = cellsOf(A, pair);
---

<MatrixRow
  cell={38}
  rows={[[
    { data: A, fills, label: "A" },
    { op: "→" },
    { data: At, fills, label: "Aᵗ" },
  ]]}
/>
