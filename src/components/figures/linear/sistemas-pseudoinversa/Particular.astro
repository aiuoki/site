---
import MapDiagram from "./MapDiagram.astro";
---

<MapDiagram
  left={{ space: "ℝᵐ", point: "b = (3, 3)", color: "var(--b)" }}
  right={{ space: "ℝⁿ", point: "Xp = (1, 2, 1)", color: "var(--csc)" }}
  forward={{ name: "R", color: "var(--g)" }}
  back={{ name: "A", color: "var(--a)" }}
  note="A·(Rb) = (AR)b = b"
/>
