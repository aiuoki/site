---
import MGrid from "../rango-inversa/MGrid.astro";
---

<svg class="mfig wide" viewBox="0 0 440 130" fill="var(--fg)" aria-hidden="true">
  <text x="22" y="68" text-anchor="middle" font-size="15">1/3</text>
  <MGrid x={42} y={34} cells={[["2", "−1", "1"], ["−1", "2", "1"]]} fills={{ r0: "var(--g)" }} />
  <text x="160" y="68" text-anchor="middle" font-size="18">·</text>
  <MGrid x={182} y={21} cells={[["1", "0"], ["0", "1"], ["1", "1"]]} fills={{ c0: "var(--a)" }} />
  <text x="274" y="68" text-anchor="middle" font-size="18">=</text>
  <MGrid x={296} y={34} cells={[["1", "0"], ["0", "1"]]} fills={{ "0,0": "var(--b)" }} />
  <text x="92" y="112" text-anchor="middle" font-size="15" font-style="italic" fill="var(--g)">L</text>
  <text x="216" y="112" text-anchor="middle" font-size="15" font-style="italic" fill="var(--a)">A</text>
  <text x="330" y="112" text-anchor="middle" font-size="15" font-style="italic" fill="var(--b)">I₂</text>
  <text x="400" y="62" text-anchor="middle" font-size="12" fill="var(--muted)">2·1 + (−1)·0</text>
  <text x="400" y="78" text-anchor="middle" font-size="12" fill="var(--muted)">+ 1·1 = 3</text>
  <text x="400" y="94" text-anchor="middle" font-size="12" fill="var(--muted)">3 ÷ 3 = 1</text>
</svg>
