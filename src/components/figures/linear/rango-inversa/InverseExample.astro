---
import { contentLang } from "../../../../i18n";
import Arr from "./Arr.astro";
import MGrid from "./MGrid.astro";

const es = contentLang(Astro) === "es";
const r = es ? "F" : "R";
const base = { cw: 30, ch: 26, divider: 2 };
---

<svg class="mfig wide" viewBox="0 0 540 130" fill="var(--fg)" aria-hidden="true">
  <MGrid x={8} y={34} {...base} cells={[["1", "2", "1", "0"], ["2", "5", "0", "1"]]} fills={{ "0,0": "var(--a)", "1,0": "var(--sec)" }} />
  <Arr x1={146} y1={60} x2={196} y2={60} color="var(--muted)" />
  <text x="171" y="48" text-anchor="middle" font-size="11" fill="var(--muted)">{`${r}₂ − 2·${r}₁`}</text>
  <MGrid x={204} y={34} {...base} cells={[["1", "2", "1", "0"], ["0", "1", "−2", "1"]]} fills={{ "1,1": "var(--a)", "0,1": "var(--sec)" }} />
  <Arr x1={342} y1={60} x2={392} y2={60} color="var(--muted)" />
  <text x="367" y="48" text-anchor="middle" font-size="11" fill="var(--muted)">{`${r}₁ − 2·${r}₂`}</text>
  <MGrid x={400} y={34} {...base} cells={[["1", "0", "5", "−2"], ["0", "1", "−2", "1"]]} fills={{ c2: "var(--g)", c3: "var(--g)" }} />
  <text x="76" y="108" text-anchor="middle" font-size="14" font-style="italic">[ A | I ]</text>
  <text x="272" y="108" text-anchor="middle" font-size="14" font-style="italic">[ I | A⁻¹ ]</text>
  <text x="468" y="108" text-anchor="middle" font-size="14" fill="var(--g)">A⁻¹</text>
</svg>
