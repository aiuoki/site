---
import { contentLang } from "../../../../i18n";
import Arr from "./Arr.astro";
import MGrid from "./MGrid.astro";

const es = contentLang(Astro) === "es";
const r = es ? "F" : "R";
const left = { c0: "var(--b)", c1: "var(--b)", c2: "var(--a)", c3: "var(--a)" };
const right = { c0: "var(--g)", c1: "var(--g)", c2: "var(--a)", c3: "var(--a)" };
---

<svg class="mfig wide" viewBox="0 0 480 130" fill="var(--fg)" aria-hidden="true">
  <MGrid x={14} y={34} divider={2} fills={left} cells={[["1", "0", "1", "2"], ["0", "1", "3", "4"]]} />
  <Arr x1={178} y1={60} x2={290} y2={60} color="var(--muted)" />
  <text x="234" y="40" text-anchor="middle" font-size="12" fill="var(--muted)">{`${r}₂ − 3·${r}₁`}</text>
  <text x="234" y="54" text-anchor="middle" font-size="12" fill="var(--muted)">{`${r}₁ + ${r}₂`}</text>
  <MGrid x={318} y={34} divider={2} fills={right} cells={[["−2", "1", "1", "0"], ["−3", "1", "0", "−2"]]} />
  <text x="88" y="108" text-anchor="middle" font-size="15" font-style="italic">[ I | A ]</text>
  <text x="392" y="108" text-anchor="middle" font-size="15" font-style="italic">[ P | B ]</text>
  <text x="234" y="108" text-anchor="middle" font-size="16" fill="var(--g)">B = P·A</text>
</svg>
