---
import MatrixRow from "../tipos-matrices/MatrixRow.astro";
import { all, mat } from "../tipos-matrices/grid";

const AC = mat([[5, 2], [2, 1]]);
const BC = mat([[2, 1], [5, 1]]);
const R = mat([[7, 3], [7, 2]]);
---

<MatrixRow
  cell={32}
  rows={[[
    { data: AC, fills: all(AC, "a"), label: "AC" },
    { op: "+" },
    { data: BC, fills: all(BC, "b"), label: "BC" },
    { op: "=" },
    { data: R, fills: all(R, "g"), label: "(A + B)C" },
  ]]}
/>
