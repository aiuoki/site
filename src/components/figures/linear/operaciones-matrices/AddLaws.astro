---
import MatrixRow from "../tipos-matrices/MatrixRow.astro";
import { all, mat } from "../tipos-matrices/grid";

const A = mat([[1, 2, 0], [3, -1, 4]]);
const B = mat([[2, 0, 5], [-1, 1, 2]]);
const S = mat([[3, 2, 5], [2, 0, 6]]);
const marks: [number, number][] = [[1, 2]];
---

<MatrixRow
  cell={28}
  rows={[[
    { data: A, fills: all(A, "a"), marks, label: "A" },
    { op: "+" },
    { data: B, fills: all(B, "b"), marks, label: "B" },
    { op: "=" },
    { data: S, fills: all(S, "g"), marks, label: "A + B" },
  ]]}
/>
