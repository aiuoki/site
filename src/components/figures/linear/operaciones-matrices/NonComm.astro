---
import MatrixRow from "../tipos-matrices/MatrixRow.astro";
import { all, mat } from "../tipos-matrices/grid";

const A = mat([[1, 2], [3, 4]]);
const B = mat([[0, 1], [1, 0]]);
const AB = mat([[2, 1], [4, 3]]);
const BA = mat([[3, 4], [1, 2]]);
const marks: [number, number][] = [[0, 0]];
---

<MatrixRow
  cell={32}
  rows={[
    [
      { data: A, fills: all(A, "a"), label: "A" },
      { op: "·" },
      { data: B, fills: all(B, "b"), label: "B" },
      { op: "=" },
      { data: AB, fills: all(AB, "g"), marks, label: "AB" },
    ],
    [
      { data: B, fills: all(B, "b"), label: "B" },
      { op: "·" },
      { data: A, fills: all(A, "a"), label: "A" },
      { op: "=" },
      { data: BA, fills: all(BA, "sec"), marks, label: "BA" },
    ],
  ]}
/>
