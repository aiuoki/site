---
import { contentLang, notationFor } from "../../i18n";
import { rad } from "../../lib/trig";
import { tint } from "../../lib/figure";
import Arc from "./parts/Arc.astro";
import Dot from "./parts/Dot.astro";
import Label from "./parts/Label.astro";
import Line from "./parts/Line.astro";
import PolarLabel from "./parts/PolarLabel.astro";
import UnitFrame from "./parts/UnitFrame.astro";

const n = notationFor(contentLang(Astro));
const a = 25;
const b = 20;
const sum = a + b;
const ta = Math.tan(rad(a));
const tg = Math.tan(rad(sum));
---

<UnitFrame>
  <Line unit x1={1} y1={-0.25} x2={1} y2={1.3} color="var(--muted)" width={1} dash="3 5" />
  <Arc r={0.24} a0={0} a1={a} color="var(--a)" fill={tint("a")} />
  <Arc r={0.36} a0={a} a1={sum} color="var(--b)" width={3} />
  <Line unit x1={0} y1={0} x2={1} y2={ta} color="var(--a)" width={2.5} />
  <Line unit x1={0} y1={0} x2={1} y2={tg} color="var(--g)" />
  <Line unit x1={1} y1={0} x2={1} y2={tg} color="var(--g)" width={4} />
  <Line unit x1={1.06} y1={0} x2={1.06} y2={ta} color="var(--a)" width={4} />
  <Dot unit x={1} y={tg} color="var(--g)" />
  <Dot unit x={1.06} y={ta} color="var(--a)" />
  <PolarLabel deg={a / 2} r={0.32} color="var(--a)">α</PolarLabel>
  <PolarLabel deg={a + b / 2} r={0.47} color="var(--b)">β</PolarLabel>
  <Label unit x={1.12} y={ta / 2} color="var(--a)" anchor="start">{n.tan} α</Label>
  <Label unit x={1.12} y={tg - 0.02} color="var(--g)" anchor="start">{n.tan}(α+β)</Label>
  <Label unit x={1} y={-0.13} italic={false}>1</Label>
</UnitFrame>
