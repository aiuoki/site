---
import { notationFor, pageLocale } from "../../i18n";
import { pointOn } from "../../lib/figure";
import CircleFrame from "./parts/CircleFrame.astro";
import Dot from "./parts/Dot.astro";
import Label from "./parts/Label.astro";
import Line from "./parts/Line.astro";

const n = notationFor(pageLocale(Astro.currentLocale));
const cx = 150;
const cy = 130;
const radius = 95;
const a = 120;
const b = 25;
const [ax, ay] = pointOn(cx, cy, a, radius);
const [bx, by] = pointOn(cx, cy, b, radius);
const [ex, ey] = pointOn(cx, cy, (a + b) / 2, radius);
const mx = (ax + bx) / 2;
const my = (ay + by) / 2;
---

<CircleFrame cx={cx} cy={cy} radius={radius} viewBox="0 0 300 268">
  <Line x1={cx} y1={cy} x2={ex} y2={ey} color="var(--g)" width={1.5} dash="5 5" />
  <Line x1={cx} y1={cy} x2={ax} y2={ay} color="var(--a)" width={2} />
  <Line x1={cx} y1={cy} x2={bx} y2={by} color="var(--b)" width={2} />
  <Line x1={ax} y1={cy} x2={ax} y2={ay} color="var(--a)" width={1.3} dash="3 4" />
  <Line x1={bx} y1={cy} x2={bx} y2={by} color="var(--b)" width={1.3} dash="3 4" />
  <Line x1={mx} y1={cy} x2={mx} y2={my} color="var(--sin)" width={4.5} />
  <Line x1={ax} y1={ay} x2={bx} y2={by} color="var(--g)" />
  <Dot x={ax} y={ay} color="var(--a)" r={5} />
  <Dot x={bx} y={by} color="var(--b)" r={5} />
  <Dot x={mx} y={my} color="var(--g)" r={5.5} />
  <Label x={ax - 10} y={ay - 8} color="var(--a)" anchor="end">A</Label>
  <Label x={bx + 10} y={by - 6} color="var(--b)" anchor="start">B</Label>
  <Label x={mx - 8} y={my - 10} color="var(--g)" anchor="end">M</Label>
  <Label x={ex + 6} y={ey - 8} color="var(--g)" anchor="start" size={14}>(α+β)/2</Label>
  <Label x={cx} y={cy + radius + 38} color="var(--sin)" size={15}>
    y<tspan font-size="11" dy="3">M</tspan><tspan dy="-3"> = ({n.sin} α + {n.sin} β) / 2</tspan>
  </Label>
</CircleFrame>
