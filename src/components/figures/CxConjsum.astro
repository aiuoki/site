---
import { plane } from "../../lib/complex-figure";
import CxArrow from "./parts/CxArrow.astro";
import CxAxes from "./parts/CxAxes.astro";
import CxText from "./parts/CxText.astro";

const m = plane({ s: 46, ox: 70, oy: 120 });
const z = [1.4, 0.6] as const;
const w = [0.6, 1.3] as const;
const sum = [2, 1.9] as const;
---

<svg class="mfig" viewBox={m.viewBox} aria-hidden="true">
  <CxAxes m={m} x0={-0.8} x1={4.6} y0={-2.3} y1={2.3} />
  <CxArrow m={m} x1={0} y1={0} x2={z[0]} y2={z[1]} color="var(--z)" width={2.4} />
  <CxArrow m={m} x1={0} y1={0} x2={w[0]} y2={w[1]} color="var(--w)" width={2.4} />
  <CxArrow m={m} x1={0} y1={0} x2={sum[0]} y2={sum[1]} color="var(--result)" width={3} />
  <CxArrow m={m} x1={0} y1={0} x2={z[0]} y2={-z[1]} color="var(--z)" width={1.8} dash="4 3" />
  <CxArrow m={m} x1={0} y1={0} x2={w[0]} y2={-w[1]} color="var(--w)" width={1.8} dash="4 3" />
  <CxArrow m={m} x1={0} y1={0} x2={sum[0]} y2={-sum[1]} color="var(--result)" width={2.4} dash="4 3" />
  <CxText m={m} x={z[0] + 0.1} y={z[1] - 0.05} t="z" color="var(--z)" anchor="start" italic />
  <CxText m={m} x={w[0] - 0.1} y={w[1] + 0.1} t="w" color="var(--w)" anchor="end" italic />
  <CxText m={m} x={sum[0] + 0.1} y={sum[1] + 0.1} t="z + w" color="var(--result)" anchor="start" italic />
  <CxText m={m} x={sum[0] + 0.1} y={-sum[1] - 0.1} t={"z̅ + w̅"} color="var(--result)" anchor="start" size={14} italic />
</svg>
