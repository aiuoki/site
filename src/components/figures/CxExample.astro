---
import { plane } from "../../lib/complex-figure";
import { minus } from "../../lib/format";
import CxArrow from "./parts/CxArrow.astro";
import CxAxes from "./parts/CxAxes.astro";
import CxDot from "./parts/CxDot.astro";
import CxLine from "./parts/CxLine.astro";
import CxText from "./parts/CxText.astro";

const m = plane({ s: 40, ox: 150, oy: 120 });
const z = [2, -1] as const;
const w = [1, 2] as const;
const ticks = [-3, -2, -1, 1, 2, 3];
const imaginary = (i: number) => (i === 1 ? "i" : i === -1 ? "−i" : `${minus(String(i))}i`);
---

<svg class="mfig" viewBox={m.viewBox} aria-hidden="true">
  <CxAxes m={m} x0={-3.2} x1={3.4} y0={-2.6} y1={2.7} />
  {
    ticks.map((i) => (
      <>
        <text x={m.px(i)} y={m.py(0) + 15} text-anchor="middle" font-size="11" fill="var(--muted)">{minus(String(i))}</text>
        {Math.abs(i) < 3 && (
          <text x={m.px(0) - 5} y={m.py(i) + 4} text-anchor="end" font-size="11" fill="var(--muted)" font-style="italic">{imaginary(i)}</text>
        )}
      </>
    ))
  }
  <CxLine m={m} x1={z[0]} y1={z[1]} x2={z[0]} y2={0} color="var(--muted)" width={1} dash="3 3" />
  <CxLine m={m} x1={z[0]} y1={z[1]} x2={0} y2={z[1]} color="var(--muted)" width={1} dash="3 3" />
  <CxLine m={m} x1={w[0]} y1={w[1]} x2={w[0]} y2={0} color="var(--muted)" width={1} dash="3 3" />
  <CxLine m={m} x1={w[0]} y1={w[1]} x2={0} y2={w[1]} color="var(--muted)" width={1} dash="3 3" />
  <CxArrow m={m} x1={0} y1={0} x2={z[0]} y2={z[1]} color="var(--z)" width={2.8} />
  <CxArrow m={m} x1={0} y1={0} x2={w[0]} y2={w[1]} color="var(--w)" width={2.8} />
  <CxDot m={m} x={z[0]} y={z[1]} color="var(--z)" />
  <CxDot m={m} x={w[0]} y={w[1]} color="var(--w)" />
  <CxText m={m} x={z[0] + 0.15} y={z[1] - 0.1} t="z = 2 − i" color="var(--z)" anchor="start" size={14} italic />
  <CxText m={m} x={w[0] + 0.15} y={w[1] + 0.1} t="w = 1 + 2i" color="var(--w)" anchor="start" size={14} italic />
</svg>
