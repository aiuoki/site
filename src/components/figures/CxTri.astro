---
import { plane } from "../../lib/complex-figure";
import { round, tint } from "../../lib/figure";
import CxArrow from "./parts/CxArrow.astro";
import CxAxes from "./parts/CxAxes.astro";
import CxText from "./parts/CxText.astro";

const m = plane({ s: 52, ox: 40, oy: 200, h: 230 });
const z = [2.6, 0.7] as const;
const w = [0.9, 2] as const;
const sum = [3.5, 2.7] as const;
const corner = (x: number, y: number) => `${round(m.px(x))} ${round(m.py(y))}`;
const triangle = `M${corner(0, 0)} L${corner(z[0], z[1])} L${corner(sum[0], sum[1])} Z`;
---

<svg class="mfig" viewBox={m.viewBox} aria-hidden="true">
  <CxAxes m={m} x0={-0.4} x1={4.9} y0={-0.4} y1={3.6} />
  <path d={triangle} fill={tint("result", 16)} />
  <CxArrow m={m} x1={0} y1={0} x2={w[0]} y2={w[1]} color="var(--w)" width={1.6} dash="4 4" />
  <CxArrow m={m} x1={0} y1={0} x2={z[0]} y2={z[1]} color="var(--z)" width={3} />
  <CxArrow m={m} x1={z[0]} y1={z[1]} x2={sum[0]} y2={sum[1]} color="var(--w)" width={3} />
  <CxArrow m={m} x1={0} y1={0} x2={sum[0]} y2={sum[1]} color="var(--result)" width={3.2} />
  <CxText m={m} x={1.4} y={0.1} t="|z|" color="var(--z)" italic />
  <CxText m={m} x={3.3} y={1.6} t="|w|" color="var(--w)" anchor="start" italic />
  <CxText m={m} x={2.05} y={1.2} t="|z + w|" color="var(--result)" italic />
  <CxText m={m} x={sum[0]} y={sum[1] + 0.3} t="z + w" color="var(--result)" size={14} italic />
</svg>
