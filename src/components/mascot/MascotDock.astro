---
// Mascot fixed at the bottom-right corner of every page. It never takes
// clicks (pointer-events: none) and the page keeps room for it at the end.
import Mascot from "./Mascot.astro";
---

<div class="mascot-dock">
  <Mascot pose="idle" size="100%" />
</div>

<style>
  /* The drawing is 1024 × 1370, so its height is width × 1.34. */
  :global(body:has(.mascot-dock)) {
    --dock-size: 88px;
    /* Room at the end of the page so the footer is never under the mascot. */
    --page-pad-bottom: calc(var(--dock-size) * 1.34 + 24px);
  }

  .mascot-dock {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: max(12px, env(safe-area-inset-bottom, 0px));
    width: var(--dock-size, 88px);
    z-index: 20;
    pointer-events: none;
  }

  @media (max-width: 600px) {
    :global(body:has(.mascot-dock)) {
      --dock-size: 60px;
    }
  }

  @media print {
    .mascot-dock {
      display: none;
    }

    :global(body:has(.mascot-dock)) {
      --page-pad-bottom: 22px;
    }
  }
</style>
