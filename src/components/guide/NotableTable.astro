---
import Table from "../interactive/trig/NotableTable.svelte";
import { contentLang, dictionaries, notationFor, type UiDict } from "../../i18n";

const lang = contentLang(Astro);
const trig = (dictionaries[lang] as UiDict).trig;
---

<Table client:visible notation={notationFor(lang)} degLabel={trig.thDeg} radLabel={trig.thRad} />
<button type="button" class="linkbtn" data-demo="notables">{trig.whereFrom}</button>
