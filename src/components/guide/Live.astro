---
import LiveCheck from "../interactive/trig/LiveCheck.svelte";
import { dictionaries, localeMeta, notationFor, pageLocale, type UiDict } from "../../i18n";
import type { CircleCheck, SumCheck } from "../../lib/trig-checks";

const { kind } = Astro.props as { kind: CircleCheck | SumCheck };
const lang = pageLocale(Astro.currentLocale);
const trig = (dictionaries[lang] as UiDict).trig;
const n = notationFor(lang);
---

<LiveCheck
  client:visible
  kind={kind}
  strings={{ ...trig.live, luck: trig.luck, direct: trig.direct }}
  names={{ sin: n.sin, cos: n.cos, tan: n.tan, rad: n.rad }}
  locale={localeMeta[lang].bcp47}
/>
