---
// Interactive canvas of each topic. Topics without one render nothing.
import "../../styles/components/interactive.css";
import AngleSum from "./trig/AngleSum.svelte";
import UnitCircle from "./trig/UnitCircle.svelte";
import { dictionaries, localeMeta, notationFor, type Locale, type UiDict } from "../../i18n";

interface Props {
  lang: Locale;
  topic: string;
}

const { lang, topic } = Astro.props;
const dict = dictionaries[lang] as UiDict;
const props = { strings: dict.trig, notation: notationFor(lang), locale: localeMeta[lang].bcp47, seeDemo: dict.demo.open };
---

{topic === "trigonometria" && <UnitCircle client:load {...props} />}
{topic === "suma-angulos" && <AngleSum client:load {...props} />}
