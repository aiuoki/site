---
import { site } from "../../config/site";
---

<footer class="foot">
  <a class="f-mail" href={`mailto:${site.email}`}>{site.email}</a>
  <a class="f-web" href={site.url}>{site.name}</a>
  <span class="f-copy">© {site.copyrightYear} {site.author}</span>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding-top: 14px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 6px 16px;
    font-size: 13px;
    color: var(--muted);
  }

  .f-mail {
    justify-self: start;
  }

  .f-web {
    justify-self: center;
  }

  .f-copy {
    justify-self: end;
  }

  a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  a:hover {
    color: var(--fg);
    border-bottom-color: currentColor;
  }

  @media (max-width: 520px) {
    .foot {
      grid-template-columns: 1fr;
    }

    .foot > * {
      justify-self: center;
    }
  }
</style>
