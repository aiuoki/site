---
import { subjects, type Subject } from "../../config/site";
import { useTranslations, type Locale, type UiKey } from "../../i18n";
import { topicPath } from "../../lib/paths";

interface Props {
  lang: Locale;
  subject: Subject;
}

const { lang, subject } = Astro.props;
const t = useTranslations(lang);

// The "back" text points to Calculus, the first available subject.
const available = subjects.find((s) => s.status === "available");
const firstTopic = available?.topics[0];
const backHref = available && firstTopic ? topicPath(lang, available.slug, firstTopic.slug) : "/";
---

<section class="soon">
  <div class="soon-ic mr" aria-hidden="true">{subject.soonSymbol ?? subject.symbol}</div>
  <h2>{t("nav.soonTitle")}</h2>
  <p>{t("nav.soonText", { s: t(`subjects.${subject.slug}` as UiKey) })}</p>
  <a class="linkbtn" href={backHref}>{t("nav.back")}</a>
</section>

<style>
  .soon {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 40px clamp(18px, 4vw, 40px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    max-width: 640px;
  }

  .soon-ic {
    font-size: 44px;
    line-height: 1;
    color: var(--muted);
    white-space: pre;
  }

  h2 {
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.15;
  }

  p {
    color: var(--muted);
  }

  .linkbtn {
    font: 600 14px var(--f-body);
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 14px;
    text-decoration: none;
  }

  .linkbtn:hover {
    border-color: var(--muted);
  }
</style>
