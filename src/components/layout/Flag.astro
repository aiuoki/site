---
import { flags } from "../../config/flags";
import type { Locale } from "../../i18n";

interface Props {
  lang: Locale;
  // Distinguishes several flags of the same language on one page.
  idSuffix: string;
}

const { lang, idSuffix } = Astro.props;
const svg = flags[lang].replaceAll("{id}", `flag-${lang}-${idSuffix}`);
---

<span class="flag" aria-hidden="true" set:html={svg} />

<style>
  .flag {
    display: inline-block;
    width: 22px;
    height: 15px;
    border-radius: 3px;
    overflow: hidden;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--fg) 18%, transparent);
    flex: none;
  }

  .flag :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
