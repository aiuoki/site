---
import Formula from "./Formula.astro";
import { figures, type FigureId } from "../figures";
import type { DemoFormulas, DemoText } from "../../demos/types";
import { withLeftSide } from "../../lib/chain";
import type { Words } from "../../lib/notation";

interface Props {
  id: string;
  formulas: DemoFormulas;
  text: DemoText;
  words?: Words;
  labels: { title: string; use: string; close: string };
}

const { id, formulas, text, words, labels } = Astro.props;
const steps = withLeftSide(formulas.steps);
const figs = formulas.figures.map((f) => figures[f as FigureId]);
---

<dialog class="demo-dialog" id={`demo-${id}`} aria-labelledby={`demo-${id}-title`}>
  <div class="dlg">
    <div class="dlg-head">
      <div>
        <span class="eyebrow">{labels.title}</span>
        <h2 id={`demo-${id}-title`} set:html={text.title} />
      </div>
      <button type="button" class="x" data-close aria-label={labels.close}>×</button>
    </div>
    <div class="stmt"><Formula tex={formulas.statement} words={words} /></div>
    {
      figs.length > 0 && (
        <div class="figrow">
          {figs.map((Figure) => (
            <Figure />
          ))}
        </div>
      )
    }
    <ol class="psteps">
      {
        steps.map((tex, i) => (
          <li>
            <div class="sf">
              <Formula tex={tex} words={words} />
            </div>
            <p set:html={text.steps[i]} />
          </li>
        ))
      }
    </ol>
    <div class="usebox">
      <b>{labels.use}</b>
      <p set:html={text.use} />
    </div>
  </div>
</dialog>
