---
interface Props {
  as?: "section" | "article" | "div";
  class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["card", className]}>
  <slot />
</Tag>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 20px;
    min-width: 0;
  }
</style>
